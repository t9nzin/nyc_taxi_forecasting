   "type": "line",
   "source": "openmaptiles",
   "source-layer": "waterway",
   "paint": {
    "line-color": "#b6d2e3",
    "line-width": [
     "interpolate",
     [
      "exponential",
      1.5
     ],
     [
      "zoom"
     ],
     12,
     1,
     16,
     4
    ]
   }
  },
  {
   "id": "aeroway",
   "type": "fill",
   "source": "openmaptiles",
   "source-layer": "aeroway",
   "filter": [
    "==",
    [
     "geometry-type"
    ],
    "Polygon"
   ],
   "paint": {
    "fill-color": "#e4e0d8"
   }
  },
  {
   "id": "building",
   "type": "fill",
