{
 "version": 8,
 "name": "NYC Taxi light",
 "glyphs": "https://tiles.openfreemap.org/fonts/{fontstack}/{range}.pbf",
 "sources": {
  "openmaptiles": {
   "type": "vector",
   "url": "https://tiles.openfreemap.org/planet",
   "attribution": "\u00a9 OpenMapTiles \u00a9 OpenStreetMap contributors \u00b7 OpenFreeMap"
  }
 },
 "layers": [
  {
   "id": "land",
   "type": "background",
   "paint": {
    "background-color": "#ebe7df"
   }
  },
  {
   "id": "landcover-green",
   "type": "fill",
   "source": "openmaptiles",
   "source-layer": "landcover",
   "filter": [
    "match",
    [
     "get",
     "class"
    ],
    [
     "grass",
     "wood",
     "farmland"
    ],
    true,
    false
   ],
   "paint": {
    "fill-color": "#cfdec2",
    "fill-opacity": 0.85
   }
  },
  {
   "id": "landuse-green",
   "type": "fill",
   "source": "openmaptiles",
   "source-layer": "landuse",
   "filter": [
    "match",
    [
     "get",
     "class"
    ],
    [
     "cemetery",
     "pitch",
     "playground",
     "stadium",
     "zoo"
    ],
    true,
    false
   ],
   "paint": {
    "fill-color": "#cfdec2",
    "fill-opacity": 0.85
   }
  },
  {
   "id": "park",
   "type": "fill",
   "source": "openmaptiles",
