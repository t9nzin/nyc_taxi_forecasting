   "source": "openmaptiles",
   "source-layer": "water_name",
   "layout": {
    "text-field": [
     "coalesce",
     [
      "get",
      "name:en"
     ],
     [
      "get",
      "name"
     ]
    ],
    "text-font": [
     "Noto Sans Italic"
    ],
    "text-size": 12,
    "symbol-placement": "point"
   },
   "paint": {
    "text-color": "#7f9fb2",
    "text-halo-color": "#b6d2e3",
    "text-halo-width": 1
   },
   "filter": [
    "==",
    [
     "geometry-type"
    ],
    "Point"
   ]
